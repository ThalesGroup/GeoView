SmalltalkCISpec {
  #loading : [
    SCIMetacelloLoadSpec {
      #baseline : 'GeoView',
      #directory : 'src',
      #platforms : [ #pharo ],
      #onConflict : #useLoaded,
      #onUpgrade : #useLoaded,
      #ignoreImage : true,
      #load: 'Core'
    }
  ],
  #testing : {
    #packages : [ 'GeoView-*' ]
  }
}
