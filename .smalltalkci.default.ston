SmalltalkCISpec {
  
  #preLoading: '
    Iceberg remoteTypeSelector: #httpsUrl.
  ',
  
  #loading : [
    SCIMetacelloLoadSpec {
      #baseline : 'GeoView',
      #directory : 'src',
      #platforms : [ #pharo ],
      #onConflict : #useLoaded,
      #onUpgrade : #useLoaded,
      #ignoreImage : true
    }
  ],
  
  #testing : {
    #packages : [ 'GeoView-*' ]
  }
}
